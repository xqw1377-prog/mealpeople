export async function createEmployee(employee: Partial<Employee>): Promise<Employee | null> {
  console.log('=== createEmployee API 调用 ===')
  console.log('接收到的员工数据:', employee)

  // 验证必需字段
  if (!employee.tenant_id) {
    console.error('❌ tenant_id 缺失')
    return null
  }
  if (!employee.store_id) {
    console.error('❌ store_id 缺失')
    return null
  }
  if (!employee.name) {
    console.error('❌ name 缺失')
    return null
  }

  const insertData = {
    tenant_id: employee.tenant_id,
    store_id: employee.store_id,
    brand_id: employee.brand_id || null, // 添加brand_id字段
    user_id: employee.user_id,
    name: employee.name,
    phone: employee.phone,
    employee_type: employee.employee_type || 'full_time',
    department: employee.department || 'front_hall',
    position: employee.position,
    status: employee.status || 'active',
    monthly_salary: employee.monthly_salary,
    daily_work_hours: employee.daily_work_hours,
    is_core_position: employee.is_core_position || false,
    position_fixed_backup: employee.position_fixed_backup || false,
    can_backup_positions: employee.can_backup_positions || []
  }

  console.log('准备插入的数据:', insertData)

  const {data, error} = await supabase.from('employees').insert(insertData).select().maybeSingle()

  if (error) {
    console.error('❌ 创建员工失败，详细错误:', error)
    console.error('错误代码:', error.code)
    console.error('错误消息:', error.message)
    console.error('错误详情:', error.details)
    return null
  }

  console.log('✅ 创建员工成功:', data)
  return data
}

export async function updateEmployee(id: string, updates: Partial<Employee>): Promise<boolean> {
  console.log('更新员工，ID:', id)
