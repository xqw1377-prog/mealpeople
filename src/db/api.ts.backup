// ==================== 品牌管理 API ====================

/**
 * 获取租户下的所有品牌
 */
export async function getBrandsByTenantId(tenantId: string): Promise<Brand[]> {
  const {data, error} = await supabase
    .from('brands')
    .select('*')
    .eq('tenant_id', tenantId)
    .order('created_at', {ascending: true})

  if (error) {
    console.error('获取品牌列表失败:', error)
    return []
  }

  return Array.isArray(data) ? data : []
}

/**
 * 根据ID获取品牌详情
 */
export async function getBrandById(brandId: string): Promise<Brand | null> {
  const {data, error} = await supabase.from('brands').select('*').eq('id', brandId).maybeSingle()

  if (error) {
    console.error('获取品牌详情失败:', error)
    return null
  }

  return data
}

/**
 * 创建新品牌
 */
export async function createBrand(brand: {
  tenant_id: string
  name: string
  industry?: string
  logo_url?: string
  description?: string
  status?: 'active' | 'inactive' // 添加可选的status字段
}): Promise<Brand | null> {
  const {data, error} = await supabase
    .from('brands')
    .insert({
      tenant_id: brand.tenant_id,
      name: brand.name,
      industry: brand.industry || null,
      logo_url: brand.logo_url || null,
      description: brand.description || null,
      status: brand.status || 'active' // 使用传入的status或默认为active
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('创建品牌失败:', error)
    return null
  }

  return data
}

/**
 * 更新品牌信息
 */
export async function updateBrand(
  brandId: string,
  updates: {
    name?: string
    industry?: string
    logo_url?: string
    description?: string
    status?: 'active' | 'inactive'
  }
): Promise<boolean> {
  const {error} = await supabase.from('brands').update(updates).eq('id', brandId)

  if (error) {
    console.error('更新品牌失败:', error)
    return false
  }

  return true
}

