// ==================== 排班结果相关API ====================

/**
 * 创建或更新排班结果
 */
export async function upsertScheduleResult(result: Omit<ScheduleResult, 'id' | 'created_at' | 'updated_at'>) {
  console.log('=== upsertScheduleResult 开始 ===')
  console.log('输入数据:', result)

  const {data, error} = await supabase
    .from('schedule_results')
    .upsert(result, {
      onConflict: 'tenant_id,store_id,operation_date'
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('保存排班结果失败:', error)
    console.error('错误详情:', {
      message: error.message,
      details: error.details,
      hint: error.hint,
      code: error.code
    })
    return null
  }

  console.log('=== upsertScheduleResult 成功 ===')
  console.log('返回数据:', data)
  return data
}

/**
 * 插入新的排班结果（用于记录调整历史）
 * 每次调用都会创建新记录，不会覆盖旧记录
 * 会自动将同一天的旧记录标记为非最新
 */
export async function insertScheduleResult(result: Omit<ScheduleResult, 'id' | 'created_at' | 'updated_at'>) {
  console.log('=== insertScheduleResult 开始 ===')
  console.log('输入数据:', result)

  // 1. 先将同一天的旧记录标记为非最新
  const {error: updateError} = await supabase
    .from('schedule_results')
    .update({is_latest: false})
    .eq('tenant_id', result.tenant_id)
    .eq('store_id', result.store_id)
    .eq('operation_date', result.operation_date)
    .eq('is_latest', true)

  if (updateError) {
    console.error('更新旧记录失败:', updateError)
  }

  // 2. 插入新记录
  const {data, error} = await supabase.from('schedule_results').insert(result).select().maybeSingle()

  if (error) {
    console.error('插入排班结果失败:', error)
    console.error('错误详情:', {
      message: error.message,
      details: error.details,
      hint: error.hint,
      code: error.code
    })
    return null
  }

  console.log('=== insertScheduleResult 成功 ===')
  console.log('返回数据:', data)
  return data
}

/**
 * 获取指定日期的排班结果（最新版本）
 */
export async function getScheduleResultByDate(tenantId: string, storeId: string, operationDate: string) {
  const {data, error} = await supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('store_id', storeId)
    .eq('operation_date', operationDate)
    .eq('is_latest', true)
    .maybeSingle()

  if (error) {
    console.error('获取排班结果失败:', error)
    return null
  }
  return data
}

/**
 * 获取日期范围内的排班结果
 */
export async function getScheduleResultsByDateRange(
  tenantId: string,
  storeId: string,
  startDate: string,
  endDate: string
) {
  const {data, error} = await supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('store_id', storeId)
    .gte('operation_date', startDate)
    .lte('operation_date', endDate)
    .order('operation_date', {ascending: false})

  if (error) {
    console.error('获取排班结果列表失败:', error)
    return []
  }
  return Array.isArray(data) ? data : []
}

/**
 * 获取某个日期的所有排班调整历史（按时间倒序）
 */
export async function getScheduleAdjustmentHistory(
  tenantId: string,
  storeId: string,
  operationDate: string
): Promise<ScheduleResult[]> {
  const {data, error} = await supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('store_id', storeId)
    .eq('operation_date', operationDate)
    .order('created_at', {ascending: false})

  if (error) {
    console.error('获取排班调整历史失败:', error)
    return []
  }
  return Array.isArray(data) ? data : []
}

// ==================== 今日运营仪表盘 ====================

/**
 * 获取今日运营仪表盘数据
 * @param tenantId 租户ID
 * @returns 今日和累计数据
 */
export async function getDashboardData(
  tenantId: string,
  storeId?: string
): Promise<{
  today: {
    revenue: number
    rest_count: number
    rest_days: number
    efficiency: number
    labor_cost: number
    thousand_yuan_contribution: number
    cost_ratio: number
    planned_staff_count: number
  }
  accumulated: {
    revenue: number
    rest_count: number
    rest_days: number
    efficiency: number
    labor_cost: number
    thousand_yuan_contribution: number
    cost_ratio: number
    planned_staff_count: number
  }
  days_count: number
}> {
  console.log('=== getDashboardData 开始 ===')
  console.log('租户ID:', tenantId)
  console.log('门店ID:', storeId)

  const today = new Date()
  const todayStr = today.toISOString().split('T')[0]

  // 获取本月第一天
  const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1)
  const firstDayStr = firstDayOfMonth.toISOString().split('T')[0]

  console.log('查询日期范围:', {today: todayStr, firstDay: firstDayStr})

  // 查询今日数据（按门店过滤）
  let todayQuery = supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('operation_date', todayStr)

  if (storeId) {
    todayQuery = todayQuery.eq('store_id', storeId)
  }

  const {data: todayData, error: todayError} = await todayQuery

  if (todayError) {
    console.error('获取今日数据失败:', todayError)
  } else {
    console.log('今日数据查询结果:', todayData)
  }

  // 查询今日营业数据（用于获取最新营收）
  let todayOperationQuery = supabase
    .from('daily_operations')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('operation_date', todayStr)

  if (storeId) {
    todayOperationQuery = todayOperationQuery.eq('store_id', storeId)
  }

  const {data: todayOperationData, error: todayOperationError} = await todayOperationQuery

  if (todayOperationError) {
    console.error('获取今日营业数据失败:', todayOperationError)
  } else {
    console.log('今日营业数据查询结果:', todayOperationData)
  }

  // 查询本月累计数据（按门店过滤）
  let monthQuery = supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .gte('operation_date', firstDayStr)
    .lte('operation_date', todayStr)

  if (storeId) {
    monthQuery = monthQuery.eq('store_id', storeId)
  }

  const {data: monthData, error: monthError} = await monthQuery

  if (monthError) {
    console.error('获取本月数据失败:', monthError)
  } else {
    console.log('本月数据查询结果数量:', monthData?.length || 0)
  }

  // 查询本月营业数据（用于获取最新营收）
  let monthOperationQuery = supabase
    .from('daily_operations')
    .select('*')
    .eq('tenant_id', tenantId)
    .gte('operation_date', firstDayStr)
    .lte('operation_date', todayStr)

  if (storeId) {
    monthOperationQuery = monthOperationQuery.eq('store_id', storeId)
  }

  const {data: monthOperationData, error: monthOperationError} = await monthOperationQuery

  if (monthOperationError) {
    console.error('获取本月营业数据失败:', monthOperationError)
  } else {
    console.log('本月营业数据查询结果数量:', monthOperationData?.length || 0)
  }

  // 计算今日数据
  const todayResult = todayData && todayData.length > 0 ? todayData[0] : null
  const todayOperation = todayOperationData && todayOperationData.length > 0 ? todayOperationData[0] : null
  console.log('今日排班结果:', todayResult)
  console.log('今日营业数据:', todayOperation)

  // 获取最新营收：优先级 actual_revenue > midday_estimated_revenue > estimated_revenue
  let todayRevenue = todayResult?.estimated_revenue || 0
  if (todayOperation) {
    if (todayOperation.actual_revenue !== null && todayOperation.actual_revenue !== undefined) {
      todayRevenue = todayOperation.actual_revenue
      console.log('使用实际营收:', todayRevenue)
    } else if (
      todayOperation.midday_estimated_revenue !== null &&
      todayOperation.midday_estimated_revenue !== undefined
    ) {
      todayRevenue = todayOperation.midday_estimated_revenue
      console.log('使用中午调整营收:', todayRevenue)
    } else if (todayOperation.estimated_revenue !== null && todayOperation.estimated_revenue !== undefined) {
      todayRevenue = todayOperation.estimated_revenue
      console.log('使用预估营收:', todayRevenue)
    }
  }

  // 获取最新排休人数：优先级 actual_rest_count > adjusted_rest_count > planned_rest_count
  let todayRestCount = todayResult?.rest_staff_count || 0
  if (todayOperation) {
    if (todayOperation.actual_rest_count !== null && todayOperation.actual_rest_count !== undefined) {
      todayRestCount = todayOperation.actual_rest_count
      console.log('使用实际排休人数:', todayRestCount)
    } else if (todayOperation.adjusted_rest_count !== null && todayOperation.adjusted_rest_count !== undefined) {
      todayRestCount = todayOperation.adjusted_rest_count
      console.log('使用调整后排休人数:', todayRestCount)
    } else if (todayOperation.planned_rest_count !== null && todayOperation.planned_rest_count !== undefined) {
      todayRestCount = todayOperation.planned_rest_count
      console.log('使用计划排休人数:', todayRestCount)
    }
  }

  // 获取最新上岗人数：优先级 actual_staff_count > adjusted_staff_count > planned_staff_count
  let todayPlannedStaff = todayResult?.planned_staff_count || 0
  if (todayOperation) {
    if (todayOperation.actual_staff_count !== null && todayOperation.actual_staff_count !== undefined) {
      todayPlannedStaff = todayOperation.actual_staff_count
      console.log('使用实际上岗人数:', todayPlannedStaff)
    } else if (todayOperation.adjusted_staff_count !== null && todayOperation.adjusted_staff_count !== undefined) {
      todayPlannedStaff = todayOperation.adjusted_staff_count
      console.log('使用调整后上岗人数:', todayPlannedStaff)
    } else if (todayOperation.planned_staff_count !== null && todayOperation.planned_staff_count !== undefined) {
      todayPlannedStaff = todayOperation.planned_staff_count
      console.log('使用计划上岗人数:', todayPlannedStaff)
    }
  }

  const todayRestDays = todayResult?.rest_days || 0
  const todayLaborCost = todayResult?.total_labor_cost || 0
  // 使用最新营收和最新上岗人数计算人效
  const todayEfficiency = todayPlannedStaff > 0 ? todayRevenue / todayPlannedStaff : 0
  const todayThousandYuanContribution = todayLaborCost > 0 ? (todayRevenue / todayLaborCost) * 1000 : 0
  const todayCostRatio = todayRevenue > 0 ? (todayLaborCost / todayRevenue) * 100 : 0

  console.log('今日计算结果:', {
    revenue: todayRevenue,
    restCount: todayRestCount,
    restDays: todayRestDays,
    plannedStaff: todayPlannedStaff,
    laborCost: todayLaborCost,
    efficiency: todayEfficiency
  })

  // 计算本月累计数据
  const monthResults = Array.isArray(monthData) ? monthData : []
  const monthOperations = Array.isArray(monthOperationData) ? monthOperationData : []
  const daysCount = monthResults.length

  // 创建日期到营业数据的映射
  const operationMap = new Map()
  monthOperations.forEach((op) => {
    operationMap.set(op.operation_date, op)
  })

  // 计算累计营收、排休人数、上岗人数，使用最新数据
  let accumulatedRevenue = 0
  let accumulatedRestCount = 0
  let accumulatedPlannedStaff = 0

  monthResults.forEach((result) => {
    const operation = operationMap.get(result.operation_date)
    let revenue = result.estimated_revenue || 0
    let restCount = result.rest_staff_count || 0
    let staffCount = result.planned_staff_count || 0

    if (operation) {
      // 营收优先级：actual_revenue > midday_estimated_revenue > estimated_revenue
      if (operation.actual_revenue !== null && operation.actual_revenue !== undefined) {
        revenue = operation.actual_revenue
      } else if (operation.midday_estimated_revenue !== null && operation.midday_estimated_revenue !== undefined) {
        revenue = operation.midday_estimated_revenue
      } else if (operation.estimated_revenue !== null && operation.estimated_revenue !== undefined) {
        revenue = operation.estimated_revenue
      }

      // 排休人数优先级：actual_rest_count > adjusted_rest_count > planned_rest_count
      if (operation.actual_rest_count !== null && operation.actual_rest_count !== undefined) {
        restCount = operation.actual_rest_count
      } else if (operation.adjusted_rest_count !== null && operation.adjusted_rest_count !== undefined) {
        restCount = operation.adjusted_rest_count
      } else if (operation.planned_rest_count !== null && operation.planned_rest_count !== undefined) {
        restCount = operation.planned_rest_count
      }

      // 上岗人数优先级：actual_staff_count > adjusted_staff_count > planned_staff_count
      if (operation.actual_staff_count !== null && operation.actual_staff_count !== undefined) {
        staffCount = operation.actual_staff_count
      } else if (operation.adjusted_staff_count !== null && operation.adjusted_staff_count !== undefined) {
        staffCount = operation.adjusted_staff_count
      } else if (operation.planned_staff_count !== null && operation.planned_staff_count !== undefined) {
        staffCount = operation.planned_staff_count
      }
    }

    accumulatedRevenue += revenue
    accumulatedRestCount += restCount
    accumulatedPlannedStaff += staffCount
  })

  const accumulatedRestDays = monthResults.reduce((sum, item) => sum + (item.rest_days || 0), 0)
  const accumulatedLaborCost = monthResults.reduce((sum, item) => sum + (item.total_labor_cost || 0), 0)
  // 使用最新营收和最新上岗人数计算人效
  const accumulatedEfficiency = accumulatedPlannedStaff > 0 ? accumulatedRevenue / accumulatedPlannedStaff : 0
  const accumulatedThousandYuanContribution =
    accumulatedLaborCost > 0 ? (accumulatedRevenue / accumulatedLaborCost) * 1000 : 0
  const accumulatedCostRatio = accumulatedRevenue > 0 ? (accumulatedLaborCost / accumulatedRevenue) * 100 : 0

  console.log('本月累计结果:', {
    daysCount,
    revenue: accumulatedRevenue,
    restCount: accumulatedRestCount,
    restDays: accumulatedRestDays,
    plannedStaff: accumulatedPlannedStaff,
    efficiency: accumulatedEfficiency
  })

  console.log('=== getDashboardData 结束 ===')

  return {
    today: {
      revenue: todayRevenue,
      rest_count: todayRestCount,
      rest_days: todayRestDays,
      efficiency: todayEfficiency,
      labor_cost: todayLaborCost,
      thousand_yuan_contribution: todayThousandYuanContribution,
      cost_ratio: todayCostRatio,
      planned_staff_count: todayPlannedStaff
    },
    accumulated: {
      revenue: accumulatedRevenue,
      rest_count: accumulatedRestCount,
      rest_days: accumulatedRestDays,
      efficiency: accumulatedEfficiency,
      labor_cost: accumulatedLaborCost,
      thousand_yuan_contribution: accumulatedThousandYuanContribution,
      cost_ratio: accumulatedCostRatio,
      planned_staff_count: accumulatedPlannedStaff
    },
    days_count: daysCount
  }
}

// 获取增强版运营仪表盘数据
export async function getEnhancedDashboardData(
  tenantId: string,
  storeId?: string
): Promise<{
  basic: {
    today: {
      revenue: number
      rest_count: number
      efficiency: number
      labor_cost: number
      thousand_yuan_contribution: number
      cost_ratio: number
      planned_staff_count: number
    }
    accumulated: {
      revenue: number
      rest_count: number
      efficiency: number
      labor_cost: number
      thousand_yuan_contribution: number
      cost_ratio: number
      planned_staff_count: number
    }
    days_count: number
  }
  schedule_stats: {
    total_schedules: number
    completed_schedules: number
    completion_rate: number
    excellent_schedules: number
    excellent_rate: number
    participating_employees: number
  }
  department_stats: {
    front_hall: {
      employee_count: number
      today_working: number
      today_rest: number
    }
    kitchen: {
      employee_count: number
      today_working: number
      today_rest: number
    }
  }
  trends: {
    revenue_trend: 'up' | 'down' | 'stable'
    efficiency_trend: 'up' | 'down' | 'stable'
    cost_trend: 'up' | 'down' | 'stable'
  }
}> {
  const basicData = await getDashboardData(tenantId, storeId)

  const today = new Date()
  const todayStr = today.toISOString().split('T')[0]
  const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1)
  const firstDayStr = firstDayOfMonth.toISOString().split('T')[0]

  // 获取排班日志统计（按门店过滤）
  let scheduleLogsQuery = supabase
    .from('schedule_logs')
    .select('*')
    .eq('tenant_id', tenantId)
    .gte('log_date', firstDayStr)
    .lte('log_date', todayStr)

  if (storeId) {
    scheduleLogsQuery = scheduleLogsQuery.eq('store_id', storeId)
  }

  const {data: scheduleLogs} = await scheduleLogsQuery

  const logs = Array.isArray(scheduleLogs) ? scheduleLogs : []
  const totalSchedules = logs.length
  const completedSchedules = logs.filter((log) => log.completion_status === 'completed').length
  const excellentSchedules = logs.filter((log) => log.score && log.score >= 90).length
  const participatingEmployees = new Set(logs.map((log) => log.employee_id)).size

  // 获取部门统计（按门店过滤）
  let employeesQuery = supabase.from('employees').select('*').eq('tenant_id', tenantId).eq('status', 'active')

  if (storeId) {
    employeesQuery = employeesQuery.eq('store_id', storeId)
  }

  const {data: employees} = await employeesQuery

  const employeeList = Array.isArray(employees) ? employees : []
  const frontHallCount = employeeList.filter((emp) => emp.department === 'front_hall').length
  const kitchenCount = employeeList.filter((emp) => emp.department === 'kitchen').length

  // 获取今日排班结果（按门店过滤）
  let todayResultQuery = supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('operation_date', todayStr)

  if (storeId) {
    todayResultQuery = todayResultQuery.eq('store_id', storeId)
  }

  const {data: todayResult} = await todayResultQuery.maybeSingle()

  const todayRestCount = todayResult?.rest_staff_count || 0
  const todayPlannedStaff = todayResult?.planned_staff_count || 0

  // 计算趋势（简化版：对比今日与本月平均）
  const avgRevenue = basicData.days_count > 0 ? basicData.accumulated.revenue / basicData.days_count : 0
  const avgEfficiency = basicData.days_count > 0 ? basicData.accumulated.efficiency / basicData.days_count : 0
  const avgCost = basicData.days_count > 0 ? basicData.accumulated.labor_cost / basicData.days_count : 0

  const revenueTrend =
    basicData.today.revenue > avgRevenue * 1.05 ? 'up' : basicData.today.revenue < avgRevenue * 0.95 ? 'down' : 'stable'
  const efficiencyTrend =
    basicData.today.efficiency > avgEfficiency * 1.05
      ? 'up'
      : basicData.today.efficiency < avgEfficiency * 0.95
        ? 'down'
        : 'stable'
  const costTrend =
    basicData.today.labor_cost > avgCost * 1.05 ? 'up' : basicData.today.labor_cost < avgCost * 0.95 ? 'down' : 'stable'

  return {
    basic: basicData,
    schedule_stats: {
      total_schedules: totalSchedules,
      completed_schedules: completedSchedules,
      completion_rate: totalSchedules > 0 ? (completedSchedules / totalSchedules) * 100 : 0,
      excellent_schedules: excellentSchedules,
      excellent_rate: totalSchedules > 0 ? (excellentSchedules / totalSchedules) * 100 : 0,
      participating_employees: participatingEmployees
    },
    department_stats: {
      front_hall: {
        employee_count: frontHallCount,
        today_working:
          frontHallCount + kitchenCount > 0
            ? Math.max(0, Math.floor((frontHallCount * todayPlannedStaff) / (frontHallCount + kitchenCount)))
            : 0,
        today_rest:
          frontHallCount + kitchenCount > 0
            ? Math.max(0, Math.floor((frontHallCount * todayRestCount) / (frontHallCount + kitchenCount)))
            : 0
      },
      kitchen: {
        employee_count: kitchenCount,
        today_working:
          frontHallCount + kitchenCount > 0
            ? Math.max(0, Math.floor((kitchenCount * todayPlannedStaff) / (frontHallCount + kitchenCount)))
            : 0,
        today_rest:
          frontHallCount + kitchenCount > 0
            ? Math.max(0, Math.floor((kitchenCount * todayRestCount) / (frontHallCount + kitchenCount)))
            : 0
      }
    },
    trends: {
      revenue_trend: revenueTrend,
      efficiency_trend: efficiencyTrend,
      cost_trend: costTrend
    }
  }
}

/**
 * 获取租户级别的排班结果统计（用于数据分析和成本管控）
 * @param tenantId 租户ID
 * @param startDate 开始日期
 * @param endDate 结束日期
 * @returns 排班结果统计数据
 */
export async function getScheduleResultsStats(tenantId: string, startDate: string, endDate: string) {
  console.log('=== getScheduleResultsStats 开始 ===', {tenantId, startDate, endDate})

  const {data, error} = await supabase
    .from('schedule_results')
    .select('*')
    .eq('tenant_id', tenantId)
    .gte('operation_date', startDate)
    .lte('operation_date', endDate)
    .order('operation_date', {ascending: false})

  if (error) {
    console.error('获取排班结果统计失败:', error)
    return {
      records: [],
      stats: {
        total_records: 0,
        total_revenue: 0,
        total_labor_cost: 0,
        avg_labor_cost_rate: 0,
        qualified_count: 0,
        qualified_rate: 0,
        avg_planned_staff: 0,
        avg_rest_staff: 0,
        total_part_time_hours: 0,
        high_efficiency_count: 0,
        normal_efficiency_count: 0,
        low_efficiency_count: 0
      }
    }
  }

  const records = Array.isArray(data) ? data : []
  console.log('查询到的排班结果记录数:', records.length)

  // 计算统计数据
  const totalRecords = records.length
  const totalRevenue = records.reduce((sum, r) => sum + (r.estimated_revenue || 0), 0)
  const totalLaborCost = records.reduce((sum, r) => sum + (r.total_labor_cost || 0), 0)
  const avgLaborCostRate =
    records.length > 0 ? records.reduce((sum, r) => sum + (r.labor_cost_rate || 0), 0) / records.length : 0
  const qualifiedCount = records.filter((r) => r.is_cost_qualified).length
  const qualifiedRate = totalRecords > 0 ? (qualifiedCount / totalRecords) * 100 : 0
  const avgPlannedStaff =
    records.length > 0 ? records.reduce((sum, r) => sum + (r.planned_staff_count || 0), 0) / records.length : 0
  const avgRestStaff =
    records.length > 0 ? records.reduce((sum, r) => sum + (r.rest_staff_count || 0), 0) / records.length : 0
  const totalPartTimeHours = records.reduce((sum, r) => sum + (r.part_time_hours || 0), 0)
  const highEfficiencyCount = records.filter((r) => r.efficiency_zone === 'high').length
  const normalEfficiencyCount = records.filter((r) => r.efficiency_zone === 'normal').length
  const lowEfficiencyCount = records.filter((r) => r.efficiency_zone === 'low').length

  const stats = {
    total_records: totalRecords,
    total_revenue: totalRevenue,
    total_labor_cost: totalLaborCost,
    avg_labor_cost_rate: avgLaborCostRate,
    qualified_count: qualifiedCount,
    qualified_rate: qualifiedRate,
    avg_planned_staff: avgPlannedStaff,
    avg_rest_staff: avgRestStaff,
    total_part_time_hours: totalPartTimeHours,
    high_efficiency_count: highEfficiencyCount,
    normal_efficiency_count: normalEfficiencyCount,
    low_efficiency_count: lowEfficiencyCount
  }

  console.log('=== getScheduleResultsStats 完成 ===', stats)

  return {
    records,
    stats
  }
}

// ==================== 邀请码管理 ====================

/**
 * 生成邀请码
 * @param tenantId 租户ID
 * @param storeId 店铺ID（可选）
 * @param role 角色
 * @param maxUses 最大使用次数
 * @param expiresInDays 有效天数
 * @param createdBy 创建人ID
 * @returns 邀请码信息
 */
export async function generateInvitationCode(
  tenantId: string,
  storeId: string | null,
  role: string,
  maxUses: number,
  expiresInDays: number,
  createdBy: string
) {
  console.log('=== generateInvitationCode 开始 ===', {tenantId, storeId, role, maxUses, expiresInDays, createdBy})

  // 获取当前用户信息用于调试
  const {data: currentUser} = await supabase.auth.getUser()
  console.log('当前认证用户:', currentUser?.user?.id)

  // 获取当前用户的 profile 信息
  const {data: profile, error: profileError} = await supabase
    .from('profiles')
    .select('id, tenant_id, role')
    .eq('id', createdBy)
    .maybeSingle()

  console.log('当前用户 profile:', profile, '错误:', profileError)

  // 生成邀请码
  const {data: codeData, error: codeError} = await supabase.rpc('generate_invitation_code')

  if (codeError || !codeData) {
    console.error('生成邀请码失败:', codeError)
    return null
  }

  const code = codeData as string
  console.log('生成的邀请码:', code)

  // 计算过期时间
  const expiresAt = new Date()
  expiresAt.setDate(expiresAt.getDate() + expiresInDays)

  console.log('准备插入邀请码记录:', {
    tenant_id: tenantId,
    store_id: storeId,
    code,
    role,
    max_uses: maxUses,
    expires_at: expiresAt.toISOString(),
    created_by: createdBy,
    status: 'active'
  })

  // 插入邀请码记录
  const {data, error} = await supabase
    .from('invitation_codes')
    .insert({
      tenant_id: tenantId,
      store_id: storeId,
      code,
      role,
      max_uses: maxUses,
      expires_at: expiresAt.toISOString(),
      created_by: createdBy,
      status: 'active'
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('保存邀请码失败:', {
      message: error.message,
      details: error.details,
      hint: error.hint,
      code: error.code
    })
    return null
  }

  console.log('=== generateInvitationCode 完成 ===', data)
  return data
}

/**
 * 验证邀请码
 * @param code 邀请码
 * @returns 验证结果
 */
export async function validateInvitationCode(code: string) {
  console.log('=== validateInvitationCode 开始 ===', {code})

  const {data, error} = await supabase.rpc('validate_invitation_code', {p_code: code})

  if (error) {
    console.error('验证邀请码失败:', error)
    return {
      is_valid: false,
      tenant_id: null,
      tenant_name: null,
      store_id: null,
      store_name: null,
      role: null,
      message: '验证失败'
    }
  }

  const result = Array.isArray(data) && data.length > 0 ? data[0] : data
  console.log('=== validateInvitationCode 完成 ===', result)
  return result
}

/**
 * 使用邀请码加入租户
 * @param code 邀请码
 * @param userId 用户ID
 * @param userName 用户名
