export async function createScheduleLog(log: Partial<ScheduleLog>): Promise<ScheduleLog | null> {
  console.log('=== createScheduleLog 开始 ===')
  console.log('输入数据:', log)

  const {data, error} = await supabase
    .from('schedule_logs')
    .insert({
      tenant_id: log.tenant_id || '',
      schedule_id: log.schedule_id || '',
      employee_id: log.employee_id || '',
      store_id: log.store_id || '',
      log_date: log.log_date || '',
      completion_status: log.completion_status,
      completion_time: log.completion_time,
      score: log.score,
      duration_minutes: log.duration_minutes,
      notes: log.notes
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('创建排班日志失败:', error)
    console.error('错误详情:', {
      message: error.message,
      details: error.details,
      hint: error.hint,
      code: error.code
    })
    return null
  }

  console.log('=== createScheduleLog 成功 ===')
  console.log('返回数据:', data)
  return data
}

export async function getScheduleLogsRanking(
  tenantId: string,
  startDate: string,
  endDate: string
): Promise<
  Array<{
    employee_id: string
    employee_name: string
    total_logs: number
    excellent_count: number
    avg_score: number
  }>
> {
  const {data, error} = await supabase
    .from('schedule_logs')
    .select(
      `
      employee_id,
      employees!inner(name),
      completion_status,
      score
    `
    )
    .eq('tenant_id', tenantId)
    .gte('log_date', startDate)
    .lte('log_date', endDate)

  if (error) {
    console.error('获取排行榜数据失败:', error)
    return []
  }

  if (!data || data.length === 0) {
    return []
  }

  // 按员工分组统计
  const employeeStats = new Map<
    string,
    {
      employee_id: string
      employee_name: string
      total_logs: number
      excellent_count: number
      total_score: number
      score_count: number
    }
  >()

  for (const log of data) {
    const employeeId = log.employee_id
    const employeeName = (log.employees as any)?.name || '未知员工'

    if (!employeeStats.has(employeeId)) {
      employeeStats.set(employeeId, {
        employee_id: employeeId,
        employee_name: employeeName,
        total_logs: 0,
        excellent_count: 0,
        total_score: 0,
        score_count: 0
      })
    }

    const stats = employeeStats.get(employeeId)!
    stats.total_logs++

    if (log.completion_status === 'excellent') {
      stats.excellent_count++
    }

    if (log.score !== null) {
      stats.total_score += log.score
      stats.score_count++
    }
  }

  // 转换为数组并计算平均分
  const ranking = Array.from(employeeStats.values()).map((stats) => ({
    employee_id: stats.employee_id,
    employee_name: stats.employee_name,
    total_logs: stats.total_logs,
    excellent_count: stats.excellent_count,
    avg_score: stats.score_count > 0 ? Math.round((stats.total_score / stats.score_count) * 10) / 10 : 0
  }))

  // 按优秀数量和平均分排序
  ranking.sort((a, b) => {
    if (b.excellent_count !== a.excellent_count) {
      return b.excellent_count - a.excellent_count
    }
    return b.avg_score - a.avg_score
  })

  return ranking
}

