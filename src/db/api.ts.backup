// ==================== 租户相关 API ====================

export async function getTenants(): Promise<Tenant[]> {
  const {data, error} = await supabase.from('tenants').select('*').order('created_at', {ascending: false})

  if (error) {
    console.error('获取租户列表失败:', error)
    return []
  }
  return Array.isArray(data) ? data : []
}

export async function getTenantById(id: string): Promise<Tenant | null> {
  const {data, error} = await supabase.from('tenants').select('*').eq('id', id).maybeSingle()

  if (error) {
    console.error('获取租户详情失败:', error)
    return null
  }
  return data
}

export async function createTenant(tenant: Partial<Tenant>): Promise<Tenant | null> {
  const {data, error} = await supabase
    .from('tenants')
    .insert({
      name: tenant.name || '',
      industry: tenant.industry,
      package_type: tenant.package_type || 'basic',
      status: tenant.status || 'active',
      admin_phone: tenant.admin_phone // 添加管理员电话
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('创建租户失败:', error)
    return null
  }
  return data
}

// 创建租户并设置管理员（用于平台授权登录）
// 新方案：调用 Edge Function，使用 service_role_key 绕过 RLS 策略
export async function createTenantWithAdmin(
  userId: string,
  phone: string
): Promise<{success: boolean; isNewTenant: boolean; message?: string}> {
  try {
    console.log('=== createTenantWithAdmin 开始（调用 Edge Function）===', {
      userId,
      phone
    })

    // 获取 Supabase URL
    const supabaseUrl = process.env.TARO_APP_SUPABASE_URL

    if (!supabaseUrl) {
      console.error('Supabase URL 未配置')
      return {
        success: false,
        isNewTenant: false,
        message: '系统配置错误'
      }
    }

    // 调用 Edge Function
    const functionUrl = `${supabaseUrl}/functions/v1/create-tenant-with-admin`
    console.log('调用 Edge Function:', functionUrl)

    const response = await fetch(functionUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${process.env.TARO_APP_SUPABASE_ANON_KEY}`
      },
      body: JSON.stringify({
        userId,
        phone
      })
    })

    console.log('Edge Function 响应状态:', response.status)

    const result = await response.json()
    console.log('Edge Function 响应结果:', result)

    if (!response.ok) {
      console.error('Edge Function 调用失败:', result)
      return {
        success: false,
        isNewTenant: false,
        message: result.message || '创建租户失败'
      }
    }

    console.log('=== createTenantWithAdmin 完成 ===')

    return {
      success: result.success,
      isNewTenant: result.isNewTenant,
      message: result.message
    }
  } catch (error) {
    console.error('createTenantWithAdmin 异常:', error)
    return {
      success: false,
      isNewTenant: false,
      message: '网络错误，请重试'
    }
  }
}

export async function updateTenant(id: string, updates: Partial<Tenant>): Promise<boolean> {
  const {error} = await supabase
    .from('tenants')
    .update({
      ...updates,
      updated_at: new Date().toISOString()
    })
    .eq('id', id)

  if (error) {
    console.error('更新租户失败:', error)
    return false
  }
  return true
}

export async function deleteTenant(id: string): Promise<boolean> {
  const {error} = await supabase.from('tenants').delete().eq('id', id)

  if (error) {
    console.error('删除租户失败:', error)
    return false
  }
  return true
}

