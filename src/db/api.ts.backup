/**
 * 更新租户配置
 */
export async function upsertTenantSettings(settings: {
  tenant_id: string
  default_daily_work_hours: number
  default_monthly_work_days?: number
  default_part_time_hourly_rate?: number
  cost_warning_threshold?: number
  efficiency_warning_threshold?: number
  brand_name?: string | null
  industry?: string | null
  contact_person?: string | null
  contact_phone?: string | null
  contact_email?: string | null
  logo_url?: string | null
  description?: string | null
}) {
  console.log('=== upsertTenantSettings 开始 ===')
  console.log('更新租户配置:', settings)

  // 获取当前用户信息用于调试
  const {data: currentUser} = await supabase.auth.getUser()
  console.log('当前认证用户:', currentUser?.user?.id)

  // 获取当前用户的 profile 信息
  const {data: profile, error: profileError} = await supabase
    .from('profiles')
    .select('id, tenant_id, role')
    .eq('id', currentUser?.user?.id || '')
    .maybeSingle()

  console.log('当前用户 profile:', profile, '错误:', profileError)

  const {data, error} = await supabase
    .from('tenant_settings')
    .upsert(
      {
        ...settings,
        updated_at: new Date().toISOString()
