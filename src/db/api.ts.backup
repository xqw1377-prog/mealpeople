/**
 * 获取租户的配置完成度统计
 */
/**
 * 检查租户是否配置了排休规则
 */
export async function hasRestDayRules(tenantId: string): Promise<boolean> {
  try {
    const {data, error} = await supabase.from('rest_day_rules').select('id').eq('tenant_id', tenantId).limit(1)

    if (error) {
      console.error('检查排休规则配置失败:', error)
      return false
    }

    return Array.isArray(data) && data.length > 0
  } catch (error) {
    console.error('检查排休规则配置异常:', error)
    return false
  }
}

export async function getConfigCompletionStats(tenantId: string): Promise<{
  basic: {completed: number; total: number; percent: number}
  business: {completed: number; total: number; percent: number}
  overall: {completed: number; total: number; percent: number}
}> {
  try {
    // 基础配置检查
    const [brands, stores, employees] = await Promise.all([
      getBrandsByTenantId(tenantId),
      getStoresByTenantId(tenantId),
      getEmployeesByTenantId(tenantId)
    ])

    const basicCompleted = [brands.length > 0, stores.length > 0, employees.length > 0].filter(Boolean).length
    const basicTotal = 3

    // 业务配置检查（增加排休规则检查）
    const [hasMealPeriod, hasEfficiency, hasPosition, hasBusinessArea, hasMinRevenue, hasRestRules] = await Promise.all(
      [
        hasMealPeriodConfig(tenantId),
        hasEfficiencyStandard(tenantId),
        hasPositionConfig(tenantId),
        hasBusinessAreaConfig(tenantId),
        hasMinRevenueConfig(tenantId),
        hasRestDayRules(tenantId)
      ]
    )

    const businessCompleted = [
      hasMealPeriod,
      hasEfficiency,
      hasPosition,
      hasBusinessArea,
      hasMinRevenue,
      hasRestRules
    ].filter(Boolean).length
    const businessTotal = 6

    // 总体完成度
    const overallCompleted = basicCompleted + businessCompleted
    const overallTotal = basicTotal + businessTotal

    return {
      basic: {
        completed: basicCompleted,
        total: basicTotal,
        percent: Math.round((basicCompleted / basicTotal) * 100)
      },
      business: {
        completed: businessCompleted,
        total: businessTotal,
        percent: Math.round((businessCompleted / businessTotal) * 100)
      },
      overall: {
        completed: overallCompleted,
        total: overallTotal,
        percent: Math.round((overallCompleted / overallTotal) * 100)
      }
    }
  } catch (error) {
    console.error('获取配置完成度统计失败:', error)
    return {
      basic: {completed: 0, total: 3, percent: 0},
      business: {completed: 0, total: 6, percent: 0},
      overall: {completed: 0, total: 9, percent: 0}
    }
  }
}

/**
 * 营收管理相关API
 */

// 获取门店营收统计数据
export async function getRevenueStats(storeId: string): Promise<{
  totalRecords: number
  currentMonthRecords: number
  lastMonthRecords: number
  earliestDate: string | null
  latestDate: string | null
}> {
  try {
    // 获取总记录数
    const {count: totalRecords} = await supabase
      .from('revenue_details')
      .select('*', {count: 'exact', head: true})
      .eq('store_id', storeId)

    // 获取本月记录数
    const now = new Date()
    const currentMonthStart = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-01`
    const {count: currentMonthRecords} = await supabase
      .from('revenue_details')
      .select('*', {count: 'exact', head: true})
      .eq('store_id', storeId)
      .gte('revenue_date', currentMonthStart)

    // 获取上月记录数
    const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1)
    const lastMonthStart = `${lastMonth.getFullYear()}-${String(lastMonth.getMonth() + 1).padStart(2, '0')}-01`
    const lastMonthEnd = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-01`
    const {count: lastMonthRecords} = await supabase
      .from('revenue_details')
      .select('*', {count: 'exact', head: true})
      .eq('store_id', storeId)
      .gte('revenue_date', lastMonthStart)
      .lt('revenue_date', lastMonthEnd)

    // 获取最早和最晚日期
    const {data: dateRange} = await supabase
      .from('revenue_details')
      .select('revenue_date')
      .eq('store_id', storeId)
      .order('revenue_date', {ascending: true})
      .limit(1)

    const {data: latestDateData} = await supabase
      .from('revenue_details')
      .select('revenue_date')
      .eq('store_id', storeId)
      .order('revenue_date', {ascending: false})
      .limit(1)

    return {
      totalRecords: totalRecords || 0,
      currentMonthRecords: currentMonthRecords || 0,
      lastMonthRecords: lastMonthRecords || 0,
      earliestDate: dateRange && dateRange.length > 0 ? dateRange[0].revenue_date : null,
      latestDate: latestDateData && latestDateData.length > 0 ? latestDateData[0].revenue_date : null
    }
  } catch (error) {
    console.error('获取营收统计数据失败:', error)
    return {
      totalRecords: 0,
      currentMonthRecords: 0,
      lastMonthRecords: 0,
      earliestDate: null,
      latestDate: null
    }
  }
}
