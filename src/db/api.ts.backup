    return []
  }
  return Array.isArray(data) ? data : []
}

/**
 * 删除兼职记录
 */
export async function deletePartTimeRecords(schedulePlanId: string) {
  const {error} = await supabase.from('part_time_records').delete().eq('schedule_plan_id', schedulePlanId)

  if (error) {
    console.error('删除兼职记录失败:', error)
    return false
  }
  return true
}

/**
 * 获取店铺正式员工数量
 */
export async function getRegularEmployeeCount(tenantId: string, storeId: string) {
  const {data, error} = await supabase
    .from('employees')
    .select('id', {count: 'exact', head: true})
    .eq('tenant_id', tenantId)
    .eq('store_id', storeId)
    .eq('employee_type', 'full_time')
    .eq('status', 'active')

  if (error) {
    console.error('获取正式员工数量失败:', error)
    return 0
  }
  return data || 0
}

