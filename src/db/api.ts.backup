}

// 批量导入员工
export interface BatchImportEmployeeData {
  name: string
  phone: string
  storeName: string
  employeeType: '正式' | '兼职'
  notes?: string
}

export interface BatchImportResult {
  success: number
  failed: number
  errors: string[]
}

export async function batchImportEmployees(
  tenantId: string,
  employees: BatchImportEmployeeData[]
): Promise<BatchImportResult> {
  const result: BatchImportResult = {
    success: 0,
    failed: 0,
    errors: []
  }

  // 获取租户的所有店铺
  const stores = await getStoresByTenantId(tenantId)
  const storeMap = new Map(stores.map((s) => [s.name, s.id]))

  // 记录已处理的手机号，避免重复
  const processedPhones = new Set<string>()

  for (let i = 0; i < employees.length; i++) {
    const emp = employees[i]
    const rowNum = i + 2 // Excel行号从2开始

    try {
      // 检查手机号是否重复
      if (processedPhones.has(emp.phone)) {
        result.failed++
        result.errors.push(`第${rowNum}行：手机号${emp.phone}重复`)
        continue
      }

      // 检查店铺是否存在
      const storeId = storeMap.get(emp.storeName)
      if (!storeId) {
        result.failed++
        result.errors.push(`第${rowNum}行：店铺"${emp.storeName}"不存在`)
        continue
      }

      // 检查手机号是否已存在于数据库
      const {data: existingEmployee} = await supabase
        .from('employees')
        .select('id')
        .eq('tenant_id', tenantId)
        .eq('phone', emp.phone)
        .maybeSingle()

      if (existingEmployee) {
        result.failed++
        result.errors.push(`第${rowNum}行：手机号${emp.phone}已存在`)
        continue
      }

      // 创建员工
      const employeeData: Partial<Employee> = {
        tenant_id: tenantId,
        store_id: storeId,
        name: emp.name,
        phone: emp.phone,
        employee_type: emp.employeeType === '正式' ? 'full_time' : 'part_time',
        department: 'front_hall',
        status: 'active'
      }

      const created = await createEmployee(employeeData)
      if (created) {
        result.success++
        processedPhones.add(emp.phone)
      } else {
        result.failed++
        result.errors.push(`第${rowNum}行：创建员工失败`)
      }
    } catch (error) {
      result.failed++
      result.errors.push(`第${rowNum}行：${error instanceof Error ? error.message : '未知错误'}`)
    }
  }

  return result
}

// ==================== 排班相关 API ====================

export async function getSchedulesByTenantId(
  tenantId: string,
  startDate?: string,
  endDate?: string
): Promise<Schedule[]> {
  let query = supabase.from('schedules').select('*').eq('tenant_id', tenantId)

  if (startDate) {
    query = query.gte('schedule_date', startDate)
  }
  if (endDate) {
    query = query.lte('schedule_date', endDate)
  }

  const {data, error} = await query.order('schedule_date', {ascending: false})

  if (error) {
    console.error('获取排班列表失败:', error)
    return []
  }
  return Array.isArray(data) ? data : []
}

export async function getSchedulesByStoreId(
  storeId: string,
  startDate?: string,
  endDate?: string
): Promise<Schedule[]> {
  let query = supabase.from('schedules').select('*').eq('store_id', storeId)

  if (startDate) {
    query = query.gte('schedule_date', startDate)
  }
  if (endDate) {
    query = query.lte('schedule_date', endDate)
  }

  const {data, error} = await query.order('schedule_date', {ascending: false})

  if (error) {
    console.error('获取店铺排班列表失败:', error)
    return []
  }
  return Array.isArray(data) ? data : []
}

export async function getScheduleById(id: string): Promise<Schedule | null> {
  const {data, error} = await supabase.from('schedules').select('*').eq('id', id).maybeSingle()

