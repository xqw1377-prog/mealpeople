    return null
  }

  console.log('getStoreEfficiencyStandard: 店铺级别查询结果', data)

  // 如果店铺没有配置，返回租户默认配置
  if (!data) {
    console.log('getStoreEfficiencyStandard: 店铺无配置，尝试获取租户级别配置')
    return getTenantEfficiencyStandard(tenantId)
