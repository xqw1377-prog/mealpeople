/**
 * 创建或更新效能标准配置
 */
export async function upsertEfficiencyStandard(standard: Partial<EfficiencyStandard>) {
  // 确保 store_id 为 null 而不是空字符串
  const cleanedStandard = {
    ...standard,
    store_id: standard.store_id || null,
    updated_at: new Date().toISOString()
  }

  console.log('准备保存效能标准配置:', cleanedStandard)

  // 先查询是否已存在
  let query = supabase.from('efficiency_standards').select('id').eq('tenant_id', cleanedStandard.tenant_id!)

  if (cleanedStandard.store_id) {
    query = query.eq('store_id', cleanedStandard.store_id)
  } else {
    query = query.is('store_id', null)
  }

  const {data: existing} = await query.maybeSingle()

  console.log('查询已存在的配置:', existing)

  let result
  if (existing) {
    // 更新现有记录
    console.log('更新现有配置，ID:', existing.id)
    const {data, error} = await supabase
      .from('efficiency_standards')
      .update(cleanedStandard)
      .eq('id', existing.id)
      .select()
      .maybeSingle()

    if (error) {
      console.error('更新效能标准配置失败:', error)
      console.error('错误详情:', {
        message: error.message,
        details: error.details,
        hint: error.hint,
        code: error.code
      })
      return null
    }
    result = data
  } else {
    // 插入新记录
    console.log('插入新配置')
    const {data, error} = await supabase.from('efficiency_standards').insert(cleanedStandard).select().maybeSingle()

    if (error) {
      console.error('插入效能标准配置失败:', error)
      console.error('错误详情:', {
        message: error.message,
        details: error.details,
        hint: error.hint,
        code: error.code
      })
      return null
    }
    result = data
  }

  console.log('保存效能标准配置成功:', result)
  return result
}

/**
 * 根据营收计算所属区间和相关信息
 */
export function calculateRevenueZone(
  revenue: number,
  standard: EfficiencyStandard
): {
  zone: 'low' | 'normal' | 'high'
  zoneName: string
  efficiencyStandard: number
  managementMotto: string
  targetWorkHours: number
  targetStaffCount: number // 新增：目标人数
} {
  let zone: 'low' | 'normal' | 'high'
  let zoneName: string
  let efficiencyStandard: number
  let managementMotto: string

  // 根据营收判断区间（含上不含下原则）
  if (revenue < standard.low_revenue_max) {
    zone = 'low'
    zoneName = '低营收区'
    efficiencyStandard = standard.low_efficiency_standard
    managementMotto = standard.low_management_motto
  } else if (revenue < standard.normal_revenue_max) {
    zone = 'normal'
    zoneName = '正常营收区'
    efficiencyStandard = standard.normal_efficiency_standard
    managementMotto = standard.normal_management_motto
  } else {
    zone = 'high'
    zoneName = '高营收区'
    efficiencyStandard = standard.high_efficiency_standard
    managementMotto = standard.high_management_motto
  }

  // 计算目标人数（营收 / 效能标准）
  const targetStaffCount = Number((revenue / efficiencyStandard).toFixed(2))

  // 计算目标工时（目标人数 * 8小时）
  const targetWorkHours = Number((targetStaffCount * 8).toFixed(1))

  return {
    zone,
    zoneName,
    efficiencyStandard,
    managementMotto,
    targetWorkHours,
    targetStaffCount
  }
}

/**
 * 评估效能达成情况
 */
export function evaluateEfficiency(
  actualRevenue: number,
  actualWorkHours: number,
  standard: EfficiencyStandard
): {
  perCapitaRevenue: number
  zone: 'low' | 'normal' | 'high'
  zoneName: string
  efficiencyStandard: number
  rating: '优秀' | '合格' | '未达标'
  ratingIcon: string
  ratingColor: string
} {
  // 计算人均营收
  const perCapitaRevenue = Number((actualRevenue / actualWorkHours).toFixed(1))

  // 确定所属区间
  const zoneInfo = calculateRevenueZone(actualRevenue, standard)

  // 评估效能
  let rating: '优秀' | '合格' | '未达标'
  let ratingIcon: string
  let ratingColor: string

  if (perCapitaRevenue >= zoneInfo.efficiencyStandard) {
    rating = '优秀'
    ratingIcon = '✅'
    ratingColor = 'text-green-600'
  } else if (perCapitaRevenue >= zoneInfo.efficiencyStandard * 0.9) {
    rating = '合格'
    ratingIcon = '⚠️'
    ratingColor = 'text-yellow-600'
  } else {
    rating = '未达标'
    ratingIcon = '❌'
    ratingColor = 'text-red-600'
  }

  return {
    perCapitaRevenue,
    zone: zoneInfo.zone,
    zoneName: zoneInfo.zoneName,
    efficiencyStandard: zoneInfo.efficiencyStandard,
    rating,
    ratingIcon,
    ratingColor
  }
}

