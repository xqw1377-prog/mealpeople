export async function createSchedule(schedule: Partial<Schedule>): Promise<Schedule | null> {
  console.log('=== createSchedule 开始 ===')
  console.log('输入数据:', schedule)

  const {
    data: {user}
  } = await supabase.auth.getUser()

  const {data, error} = await supabase
    .from('schedules')
    .insert({
      tenant_id: schedule.tenant_id || '',
      store_id: schedule.store_id || '',
      employee_id: schedule.employee_id || '',
      schedule_date: schedule.schedule_date || '',
      shift_type: schedule.shift_type,
      start_time: schedule.start_time,
      end_time: schedule.end_time,
      status: schedule.status || 'pending',
      notes: schedule.notes,
      created_by: user?.id
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('创建排班失败:', error)
    console.error('错误详情:', {
      message: error.message,
      details: error.details,
      hint: error.hint,
      code: error.code
    })
    return null
  }

  console.log('=== createSchedule 成功 ===')
  console.log('返回数据:', data)
  return data
}

/**
 * 创建排休记录
 * @param dayOff 排休记录数据
 * @returns 创建的排休记录
 */
export async function createDayOffSchedule(dayOff: {
  tenant_id: string
  store_id: string
  employee_id: string
  schedule_date: string
  meal_period: 'all_day' | 'breakfast' | 'lunch' | 'dinner'
  rest_hours: number
  notes?: string
}): Promise<Schedule | null> {
  console.log('=== createDayOffSchedule 开始 ===')
  console.log('输入数据:', dayOff)

  const {
    data: {user}
  } = await supabase.auth.getUser()

  const {data, error} = await supabase
    .from('schedules')
    .insert({
      tenant_id: dayOff.tenant_id,
      store_id: dayOff.store_id,
      employee_id: dayOff.employee_id,
      schedule_date: dayOff.schedule_date,
      is_day_off: true, // 标记为排休记录
      meal_period: dayOff.meal_period,
      rest_hours: dayOff.rest_hours,
      status: 'approved', // 排休记录直接批准
      notes: dayOff.notes || '快速排休',
      created_by: user?.id
    })
    .select()
    .maybeSingle()

  if (error) {
    console.error('创建排休记录失败:', error)
    console.error('错误详情:', {
      message: error.message,
      details: error.details,
      hint: error.hint,
      code: error.code
    })
    return null
  }

  console.log('=== createDayOffSchedule 成功 ===')
  console.log('返回数据:', data)
  return data
}

/**
 * 获取指定日期的排休记录
 * @param tenantId 租户ID
 * @param storeId 店铺ID
 * @param scheduleDate 日期
 * @returns 排休记录列表
 */
export async function getDayOffSchedules(tenantId: string, storeId: string, scheduleDate: string): Promise<Schedule[]> {
  const {data, error} = await supabase
    .from('schedules')
    .select('*')
    .eq('tenant_id', tenantId)
    .eq('store_id', storeId)
    .eq('schedule_date', scheduleDate)
    .eq('is_day_off', true)
    .order('created_at', {ascending: false})

  if (error) {
    console.error('获取排休记录失败:', error)
    return []
  }
  return Array.isArray(data) ? data : []
}

