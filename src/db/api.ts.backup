/**
 * 获取店铺的效能标准配置
 */
export async function getStoreEfficiencyStandard(tenantId: string, storeId: string) {
  console.log('getStoreEfficiencyStandard: 查询店铺级别配置', {tenantId, storeId})

  const {data, error} = await supabase
    .from('efficiency_standards')
    .select('*')
