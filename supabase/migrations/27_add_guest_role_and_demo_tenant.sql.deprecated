-- ============================================================================
-- 7. RLS 策略 - guest 用户可以查看测试餐厅数据
-- ============================================================================

-- guest 可以查看测试餐厅
DROP POLICY IF EXISTS "guest可以查看测试餐厅" ON tenants;
CREATE POLICY "guest可以查看测试餐厅" ON tenants
  FOR SELECT
  USING (
    is_demo = true 
    AND EXISTS (
      SELECT 1 FROM profiles 
      WHERE profiles.id = auth.uid() 
      AND profiles.role = 'guest'::user_role
    )
  );

-- guest 可以查看测试门店
DROP POLICY IF EXISTS "guest可以查看测试门店" ON stores;
CREATE POLICY "guest可以查看测试门店" ON stores
  FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM tenants 
      WHERE tenants.id = stores.tenant_id 
      AND tenants.is_demo = true
    )
    AND EXISTS (
      SELECT 1 FROM profiles 
      WHERE profiles.id = auth.uid() 
      AND profiles.role = 'guest'::user_role
    )
  );

-- guest 可以查看测试员工
DROP POLICY IF EXISTS "guest可以查看测试员工" ON employees;
CREATE POLICY "guest可以查看测试员工" ON employees
  FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM tenants 
      WHERE tenants.id = employees.tenant_id 
      AND tenants.is_demo = true
    )
    AND EXISTS (
      SELECT 1 FROM profiles 
      WHERE profiles.id = auth.uid() 
      AND profiles.role = 'guest'::user_role
    )
  );

-- guest 可以查看测试效能标准
DROP POLICY IF EXISTS "guest可以查看测试效能标准" ON efficiency_standards;
CREATE POLICY "guest可以查看测试效能标准" ON efficiency_standards
  FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM tenants 
      WHERE tenants.id = efficiency_standards.tenant_id 
      AND tenants.is_demo = true
    )
    AND EXISTS (
      SELECT 1 FROM profiles 
      WHERE profiles.id = auth.uid() 
      AND profiles.role = 'guest'::user_role
    )
  );

-- guest 可以查看测试排班日志
DROP POLICY IF EXISTS "guest可以查看测试排班日志" ON schedule_logs;
CREATE POLICY "guest可以查看测试排班日志" ON schedule_logs
  FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM tenants 
      WHERE tenants.id = schedule_logs.tenant_id 
      AND tenants.is_demo = true
    )
    AND EXISTS (
      SELECT 1 FROM profiles 
      WHERE profiles.id = auth.uid() 
      AND profiles.role = 'guest'::user_role
    )
  );

-- ============================================================================
-- 8. 辅助函数
-- ============================================================================

-- 获取测试餐厅ID
CREATE OR REPLACE FUNCTION get_demo_tenant_id()
RETURNS uuid
LANGUAGE sql
STABLE
AS $$
  SELECT id FROM tenants WHERE is_demo = true AND status = 'active' LIMIT 1;
$$;

-- 检查用户是否为guest
CREATE OR REPLACE FUNCTION is_guest_user(uid uuid)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
AS $$
  SELECT EXISTS (
    SELECT 1 FROM profiles 
    WHERE id = uid 
    AND role = 'guest'::user_role
  );
$$;

-- 将guest转换为租户管理员
CREATE OR REPLACE FUNCTION convert_guest_to_tenant_admin(
  user_id uuid,
  new_tenant_id uuid
)
RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
  IF NOT is_guest_user(user_id) THEN
    RAISE EXCEPTION '用户不是guest';
  END IF;
  
  UPDATE profiles
  SET 
    role = 'tenant_admin'::user_role,
    tenant_id = new_tenant_id
  WHERE id = user_id;
  
  RETURN true;
EXCEPTION
  WHEN OTHERS THEN
    RETURN false;
END;
$$;

COMMENT ON TYPE user_role IS '用户角色：super_admin(超级管理员), tenant_admin(租户管理员), store_manager(店经理), employee(员工), guest(体验用户)';
