/*
# 添加游客角色和测试餐厅

## 1. 功能说明

实现新的登录和体验模式：
- 所有人都能登录（手机号+验证码）
- 未授权用户进入体验模式（guest角色）
- 授权用户进入正常模式
- 测试餐厅提供完整的30天数据

## 2. 主要变更

### 2.1 用户角色
- 添加 guest 角色（体验用户）
- guest 用户只能查看测试餐厅数据
- guest 用户不能修改任何数据

### 2.2 测试餐厅
- 创建测试餐厅（is_demo = true）
- 3个门店
- 20个员工
- 30天完整数据

### 2.3 权限控制
- guest 用户只能查看测试餐厅数据
- 授权用户可以查看和修改自己租户的数据

*/

-- ============================================================================
-- 1. 添加 guest 角色
-- ============================================================================

ALTER TYPE user_role ADD VALUE IF NOT EXISTS 'guest';

-- ============================================================================
-- 2. 添加 is_demo 字段
-- ============================================================================

ALTER TABLE tenants ADD COLUMN IF NOT EXISTS is_demo boolean DEFAULT false;
CREATE INDEX IF NOT EXISTS idx_tenants_is_demo ON tenants(is_demo) WHERE is_demo = true;
COMMENT ON COLUMN tenants.is_demo IS '是否为测试餐厅';

-- ============================================================================
-- 3. 创建测试餐厅
-- ============================================================================

INSERT INTO tenants (
  id,
  name,
  industry,
  status,
  is_demo,
  created_at
) VALUES (
  '00000000-0000-0000-0000-000000000001',
  '测试餐厅',
  '餐饮',
  'active',
  true,
  now()
) ON CONFLICT (id) DO UPDATE SET
  name = EXCLUDED.name,
  is_demo = EXCLUDED.is_demo;

